{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{admin/**,config/**,includes/**,api/**,*.php}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)\\.(sql|sqlite|log|ini|env|md|git.*)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
